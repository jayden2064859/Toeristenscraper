    // zoekparameters die voor elk platform gebruikt worden, zodat de data onderling vergelijkbaar is
    // zoekparameters zijn verplicht bij detailoperaties zoals StaysPdpSections om de benodigde data op te kunnen halen
    "SearchParameters": {
      "CheckInOffsetDays": 14, // aankomstdatum = scrapedatum + CheckInOffsetDays aantal dagen
      "Nights": 1, // aantal overnachtingen. Het geconfigureerde aantal wordt overschreven als de minimale verblijfsduur op de incheckdatum langer is
      "Adults": 1,
      "Children": 0,
      "Pets": 0
    },
    "Booking": {
      "BaseUrl": "https://www.booking.com/",
      "MaxDepth": 10, // maximaal aantal keer dat een tegel verder opgesplitst mag worden
      "RequestDelayMs": 250 // delay tussen requests (in milliseconden)
    },
    "Airbnb": {
      "BaseUrl": "https://www.airbnb.nl/", // moet '.nl' blijven zodat in de responses de correcte measurement units en currency teruggegeven worden
      "ApiKey": "d306zoyjsyarp7ifhu67rjxn52tv0t20",
      "StaysPdpSectionsHash": "2ace69cdb5bbf9d3ebb31062e52396d61b56d2e16c695af0feda54ac7f233785", // startwaarde van de hash. wanneer deze verloopt, haalt AirbnbHashProvider een nieuwe hash op met Playwright, waarna de nieuwe hash gebruikt zal worden zolang het project draait.
      "MaxDepth": 10,
      "RequestDelayMs": 250
    },
    // polly configuraties (foutafhandeling)
    "Resilience": {
      "MaxRetries": 3, // maximaal aantal keer dat een request opnieuw geprobeerd wordt bij een fout
      "RetryDelaySeconds": 2, // aantal seconden dat gewacht wordt voordat een request opnieuw geprobeerd wordt bij een fout
      "RateLimitMaxRetries": 1, // maximaal aantal keer dat een request opnieuw geprobeerd wordt bij een rate limit fout (429-response)
      "RateLimitDelaySeconds": 30, // aantal seconden wachttijd bij een 429-response, alleen gebruikt als het platform geen Retry-After-header meestuurt
      "CircuitMinimumThroughput": 3, // minimaal aantal requests binnen de meetperiode voordat de circuit breaker kan openen
      "CircuitSamplingSeconds": 120, // meetperiode in seconden waarover de circuit breaker het aandeel 429-responses berekent
      "CircuitBreakDurationSeconds": 60, // aantal seconden dat het circuit open blijft. De orchestrator stopt het platform bij een open circuit, dus in de praktijk stopt het platform voor de rest van de run
      "CircuitFailureRatio": 1.0, // aandeel 429-responses binnen de meetperiode waarbij het circuit opent (1.0 = alle requests). Alleen 429 telt mee, andere fouten niet
      "TimeoutSeconds": 10, // maximaal aantal seconden per poging. Na een timeout volgt een retry
      "MaxConsecutiveFailures": 10 // aantal keer dat listings achter elkaar mogen mislukken voordat een platform-run gestopt wordt
    }
  },
  "Schedule": {
    "RunTime": "03:00:00", // tijdstip waarop elke dag gescraped zal worden 
    "RunOnStartup": false,
    "TimeZone": "Europe/Amsterdam"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Polly": "Warning",
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Toeristenscraper"
    }
  }
}
