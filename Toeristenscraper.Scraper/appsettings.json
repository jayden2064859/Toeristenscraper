    // polly configuraties (foutafhandeling)
    "Resilience": {
      "MaxRetries": 3, // maximaal aantal keer dat een request opnieuw geprobeerd wordt bij een fout
      "RetryDelaySeconds": 2, // aantal seconden dat gewacht wordt voordat een request opnieuw geprobeerd wordt bij een fout
      "RateLimitMaxRetries": 1, // maximaal aantal keer dat een request opnieuw geprobeerd wordt bij een rate limit fout (429-response)
      "RateLimitDelaySeconds": 30, // aantal seconden wachttijd bij een 429-response, alleen gebruikt als het platform geen Retry-After-header meestuurt
      "CircuitMinimumThroughput": 3, // minimaal aantal requests binnen de meetperiode voordat de circuit breaker kan openen
      "CircuitSamplingSeconds": 120, // meetperiode in seconden waarover de circuit breaker het aandeel 429-responses berekent
      "CircuitBreakDurationSeconds": 60, // aantal seconden dat het circuit open blijft. De orchestrator stopt het platform bij een open circuit, dus in de praktijk stopt het platform voor de rest van de run
      "CircuitFailureRatio": 1.0, // aandeel 429-responses binnen de meetperiode waarbij het circuit opent (1.0 = alle requests). Alleen 429 telt mee, andere fouten niet
      "TimeoutSeconds": 10 // maximaal aantal seconden per poging. Na een timeout volgt een retry
    }
  },
